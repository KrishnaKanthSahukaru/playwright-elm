{
  "name": "playwright-automation",
  "version": "1.0.0",
  "description": "API-first Playwright test automation framework",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test src/tests/api",
    "test:ui": "playwright test src/tests/ui --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "test:real-api": "cross-env API_MODE=real playwright test src/tests/api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.0",
    "dotenv": "^17.4.2"
  }
}
